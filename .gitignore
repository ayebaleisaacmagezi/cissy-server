# Runtime data — app configs, generated Flutter projects, build artifacts.
# Lives on the server only; never committed.
projects/

# Payment records and the current subscription. Real ones name real customers'
# phone numbers, so they belong on the box and nowhere else.
payments/
subscription.json

# Signing material. If any of these ever reach a commit, the upload key is
# compromised and Google will not reset it.
*.jks
*.keystore
*.p12
*.pfx
key.properties
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor temp files
*.tmp
*.tmp.*
